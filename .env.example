# Soroban RPC endpoint (required). Never commit secrets here.
RPC_URL=https://soroban-testnet.stellar.org
NETWORK=testnet
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# SQLite for zero-config local dev:
DATABASE_URL=sqlite:./data/sorex.db
# PostgreSQL for production:
# DATABASE_URL=postgres://sorex:sorex@localhost:5432/sorex
# STORAGE_DRIVER=postgres

# Start at the current chain head when omitted. On testnet you can use a recent ledger.
# START_LEDGER=5670000
# END_LEDGER=

# Optional filters. Contract IDs are comma-separated (max 5 per RPC filter; larger
# sets are chunked into independent cursor streams automatically).
# CONTRACT_ID_FILTERS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# TOPIC_FILTERS_JSON=[["transfer","*","*","**"]]

POLL_INTERVAL_MS=5000
BATCH_SIZE=200
GAP_CHECK_INTERVAL_MS=60000
MAX_RETRIES=5
RETRY_BASE_DELAY_MS=500
REQUEST_TIMEOUT_MS=15000

HEALTH_PORT=9464
HEALTH_HOST=0.0.0.0
METRICS_ENABLED=true

LOG_LEVEL=info
LOG_PRETTY=true
STREAM_ID=live
SHUTDOWN_TIMEOUT_MS=15000
