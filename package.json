{
  "name": "sorex-indexer-engine",
  "version": "0.1.0",
  "description": "Self-hostable Soroban event indexer: cursor-safe ingestion, SCVal decoding, PostgreSQL/SQLite storage and Prometheus metrics.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sorex-indexer": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "stellar",
    "soroban",
    "indexer",
    "events",
    "xdr",
    "scval"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ojuotimi932/sorex-indexer-engine"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts start",
    "build": "tsup",
    "start": "node dist/main.js start",
    "migrate": "tsx src/main.ts migrate",
    "capture-fixtures": "tsx scripts/capture-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:postgres": "vitest run test/postgres.integration.test.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "kysely": "^0.29.8",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.1.0"
  }
}
